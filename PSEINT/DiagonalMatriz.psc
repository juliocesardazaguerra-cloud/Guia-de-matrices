Algoritmo DiagonalMatriz
    Definir matriz Como Entero;
    Dimension matriz[2,2];
    
    // Asignación manual de valores diferentes
    matriz[0,0] <- 10;
    matriz[0,1] <- 20;
    matriz[1,0] <- 30;
    matriz[1,1] <- 40;
    
    // Impresión de los elementos de la diagonal principal
    Escribir "Valores de la diagonal principal:";
    Escribir "Posicion: ", matriz[0,0];
    Escribir "Posicion: ", matriz[1,1];
FinAlgoritmo
